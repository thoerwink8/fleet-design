{
  "name": "@fleet/design",
  "version": "0.3.0",
  "private": false,
  "description": "Shared design tokens and component styles",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thoerwink8/fleet-design.git"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./styles.css": "./dist/styles.css",
    "./reset.css": "./dist/reset.css",
    "./styles/*": "./styles/*",
    "./tailwind": "./tailwind/theme.css",
    "./tailwind/extend": "./tailwind/extend.css",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/internal": null,
    "./react/*": {
      "types": "./dist/react/*.d.ts",
      "default": "./dist/react/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles",
    "tailwind",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "stop": "node scripts/stop.mjs",
    "check": "node scripts/check.mjs",
    "format": "biome format --write .",
    "baseline": "node scripts/baseline.mjs",
    "test:react": "playwright test",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.18.1"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "postcss": "8.5.33",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  },
  "keywords": [
    "design-tokens",
    "css",
    "tailwind",
    "design-system"
  ]
}
