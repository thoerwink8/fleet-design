{
  "name": "@fleet/design",
  "version": "0.1.0",
  "private": false,
  "description": "Shared design tokens and component styles",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thoerwink8/fleet-design.git"
  },
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./styles.css": "./dist/styles.css",
    "./styles/*": "./styles/*",
    "./tailwind": "./tailwind/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles",
    "tailwind",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "stop": "node scripts/stop.mjs",
    "check": "node scripts/check.mjs",
    "format": "biome format --write .",
    "baseline": "node scripts/baseline.mjs"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "playwright": "1.64.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5"
  },
  "keywords": [
    "design-tokens",
    "css",
    "tailwind",
    "design-system"
  ]
}
