  {
    "name": "Tooltip",
    "card": "Tooltip",
    "subtitle": "React：Tooltip（Base UI Tooltip）。悬停、聚焦、Esc、快捷键",
    "compare": [
      [
        ".fa-tip",
        ".fa-tip[style*=max-width]",
        {
          "ignore": ["tag", "display", "min-block-size", "min-height", "min-inline-size", "min-width"],
          "why": "the card shows the tip as a span inside a flex row (blockified); the component renders the popup as a div inside its positioner"
